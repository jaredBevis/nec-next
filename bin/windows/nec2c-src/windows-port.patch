 /* Returns process time (user+system) BUT in _msec_ */
 void secnds( double *x)
 {
+#ifdef _WIN32
+  *x = 1000.0 * (double)clock() / CLOCKS_PER_SEC;
+  return;
+#else
   struct tms buffer;
   double clk_tck;
 
